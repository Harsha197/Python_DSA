    {
      "cell_type": "code",
      "source": [
        "#sum of range 2 to 5 th index and prefix sum\n",
        "arr = [2, 4, 6, 8, 10, 12]\n",
        "prefix = [0] * len(arr)\n",
        "prefix[0] = arr[0]\n",
        "for i in range(1, len(arr)):\n",
        "    prefix[i] = prefix[i - 1] + arr[i]\n",
        "l = 2\n",
        "r = 5\n",
        "if l == 0:\n",
        "    range_sum = prefix[r]\n",
        "else:\n",
        "    range_sum = prefix[r] - prefix[l - 1]\n",
        "print(\"Prefix Sum:\", prefix)\n",
        "print(\"Sum from index\", l, \"to\", r, \"=\", range_sum)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6t3YCA76BaqT",
        "outputId": "d070a07e-279a-442f-f7b8-8cad39b670ad"
      },
      "execution_count": 44,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Prefix Sum: [2, 6, 12, 20, 30, 42]\n",
            "Sum from index 2 to 5 = 36\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Equilibrium\n",
        "arr = [1, 3, 5, 2, 2]\n",
        "total_sum = sum(arr)\n",
        "left_sum = 0\n",
        "for i in range(len(arr)):\n",
        "    total_sum -= arr[i]\n",
        "    if left_sum == total_sum:\n",
        "        print(\"Equilibrium Index:\", i)\n",
        "        break\n",
        "    left_sum += arr[i]\n",
        "else:\n",
        "    print(\"No Equilibrium Index Found\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "GubmnQFrGjHD",
        "outputId": "113e1c5d-9f35-4ad1-d039-25a121e35e6e"
      },
      "execution_count": 45,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Equilibrium Index: 2\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#sub_array equals total k\n",
        "arr = [1, 1, 1]\n",
        "k = 2\n",
        "prefix_sum = 0\n",
        "count = 0\n",
        "prefix = {0: 1}\n",
        "for num in arr:\n",
        "    prefix_sum += num\n",
        "    if (prefix_sum - k) in prefix:\n",
        "        count += prefix[prefix_sum - k]\n",
        "    prefix[prefix_sum] = prefix.get(prefix_sum, 0) + 1\n",
        "print(\"Number of subarrays:\", count)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fAeDKiVZKjuy",
        "outputId": "e4f20c3b-612d-4d51-b077-b095c0736bba"
      },
      "execution_count": 46,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Number of subarrays: 2\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Maximum Subarray\n",
        "arr = [-2, 1, -3, 4, -1, 2, 1, -5, 4]\n",
        "max_sum = arr[0]\n",
        "current_sum = arr[0]\n",
        "for i in range(1, len(arr)):\n",
        "    current_sum = max(arr[i], current_sum + arr[i])\n",
        "    max_sum = max(max_sum, current_sum)\n",
        "print(\"Maximum Subarray Sum:\", max_sum)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
